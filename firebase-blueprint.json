        "arrivedAt": { "type": "string" },
        "scannedBy": { "type": "string" },
        "jamaahNama": { "type": "string" }
      },
      "required": ["id", "paketId", "bagType", "status", "registeredAt"]
    },
    "BlueprintNode": {
      "title": "BlueprintNode",
      "description": "Node arsitektur diagram sistem ERP Umaroh",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "step": { "type": "number" },
        "title": { "type": "string" },
        "role": { "type": "string", "enum": ["mitra_dev", "operasional", "finance", "marketing", "owner", "jamaah", "mitra", "admin"] },
        "roleLabel": { "type": "string" },
        "description": { "type": "string" },
        "inputFrom": { "type": "string" },
        "outputTo": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "warning", "completed"] }
      },
      "required": ["id", "step", "title", "role", "roleLabel", "status"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Konfigurasi sistem global (seperti kurs mata uang)",
      "type": "object",
      "properties": {
        "sarToIdr": { "type": "number" },
        "usdToIdr": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["sarToIdr", "usdToIdr"]
    }
  },
