    "Notification": {
      "title": "Notification",
      "description": "Pemberitahuan atau notifikasi sistem real-time untuk admin, mitra dan jamaah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
