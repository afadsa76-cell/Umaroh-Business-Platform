rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // HELPERS (PILLAR 3: Path Variable Hardening)
    // ===============================================================
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Auth tokens NEVER contain custom claims. explicitly lookup roles on a trusted document.
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == "operationalumaroh@gmail.com" ||
          request.auth.token.email == "afadsa76@gmail.com" ||
          request.auth.token.email == "admin@umaroh.com"
        )) ||
        // Master admins without strict verification for dev
        request.auth.token.email == "afadsa76@gmail.com" ||
        request.auth.token.email == "operationalumaroh@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOperasional() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operasional')
      );
    }

    function isFinance() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operasional' && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subRole == 'finance')
      );
    }

    function isMitra() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mitra')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===============================================================
    // VALIDATION BLUEPRINTS (PILLAR 2: Anti-Update-Gap)
    // ===============================================================
    
    function isValidUserProfile(data) {
      return (data.get('name', '') is string || data.get('namaLengkap', '') is string || data.get('brandName', '') is string) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 255)) &&
             (!('role' in data) || (data.role in ['operasional', 'mitra', 'jamaah', 'admin']));
    }

    function isValidWallet(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.balance is number &&
             data.updatedAt is string; // Using string as shown in blueprint properties (format: date-time)
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.amount is number &&
             data.status is string &&
             data.createdAt is string;
    }

    function isValidPaketMaster(data) {
      return data.nama is string && data.nama.size() <= 255 &&
             data.hargaDasar is number &&
             data.status in ['draft', 'published', 'closed', 'pending_validation', 'active'] &&
             (!('validationStatus' in data) || data.validationStatus in ['pending', 'approved', 'rejected']);
    }

    function isValidBooking(data) {
      return (data.get('jamaahId', '') == '' || data.jamaahId is string) &&
             (data.get('statusPembayaran', '') is string) &&
             (data.get('totalHarga', 0) is number);
    }

    function isValidPendaftaranMitra(data) {
      return data.nama is string && data.nama.size() <= 255 &&
             data.email is string && data.email.size() <= 255 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'pending_validation', 'approved', 'rejected'] &&
             data.createdAt is string;
    }

    function isValidShopOrder(data) {
      return data.jamaahId is string && data.jamaahId.size() <= 128 &&
             data.productName is string && data.productName.size() <= 255 &&
             data.productPrice is number &&
             data.quantity is number &&
             data.totalCost is number &&
             data.paymentMethod is string &&
             data.status is string;
    }

    // ===============================================================
    // COLLECTIONS
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || (isSignedIn() && isOperasional()) || isAdmin() || (isSignedIn() && (resource.data.email == request.auth.token.email));
      allow list: if isOperasional() || isAdmin() || 
                  (isSignedIn() && (resource.data.email == request.auth.token.email)) ||
                  (resource.data.role == 'mitra') || 
                  (resource.data.uplineId == request.auth.uid);
      allow create: if (isSignedIn() && isOwner(userId) && isValidUserProfile(incoming())) || isOperasional() || isAdmin();
      allow update: if (isAdmin() || isOperasional() || isOwner(userId)) && 
                    isValidUserProfile(incoming()) && (
                      isAdmin() || isOperasional() || (
                        (!('role' in incoming()) || !('role' in existing()) || incoming().role == existing().role) &&
                        (!('email' in incoming()) || !('email' in existing()) || incoming().email == existing().email) &&
                        (!('uid' in incoming()) || !('uid' in existing()) || incoming().get('uid', '') == existing().get('uid', ''))
                      )
                    );
      allow delete: if isAdmin() || isOperasional() || (isSignedIn() && (resource.data.email == request.auth.token.email || resource.data.get('email', '') == request.auth.token.email));
    }

    match /wallets/{walletId} {
      allow get: if isOwner(walletId) || isFinance() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(walletId)) && get(/databases/$(database)/documents/users/$(walletId)).data.email == request.auth.token.email);
      allow list: if isFinance();
      allow update: if isFinance() && 
                    isValidWallet(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']);
      // Allow creation by finance or when user registers (if app does it client-side)
      allow create: if isFinance() || (isSignedIn() && isOwner(walletId) && isValidWallet(incoming()));
      allow delete: if isFinance() || isOwner(walletId) || isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(walletId)) && get(/databases/$(database)/documents/users/$(walletId)).data.email == request.auth.token.email);
    }

    match /transactions/{transactionId} {
      allow get: if isOwner(resource.data.userId) || isFinance() || isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid));
      allow list: if isFinance() || isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid));
      allow create: if isSignedIn() && 
                    incoming().userId == request.auth.uid && 
                    isValidTransaction(incoming());
      allow write: if (isFinance() || isAdmin()) && isValidTransaction(incoming());
    }

    match /paket_master/{paketId} {
      allow read: if isSignedIn();
      allow create: if (isOperasional() || isMitra()) && isValidId(paketId) && isValidPaketMaster(incoming());
      allow update: if isValidId(paketId) && (
        isAdmin() || 
        (isValidPaketMaster(incoming()) && (
          isOperasional() || 
          (isMitra() && existing().mitraId == request.auth.uid && (
            // Mitra can't publish if not approved
            (incoming().status == 'published' ? (existing().get('validationStatus', 'pending') == 'approved') : true)
          ))
        ))
      );
      allow delete: if isAdmin() || (isMitra() && existing().mitraId == request.auth.uid);
    }

    match /paket_mitra/{paketId} {
      allow read: if isSignedIn();
      allow create: if isMitra() && incoming().mitraId == request.auth.uid && isValidId(paketId);
      allow update: if (isMitra() && existing().mitraId == request.auth.uid) || isOperasional();
      allow delete: if (isMitra() && existing().mitraId == request.auth.uid) || isOperasional();
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
                    resource.data.jamaahId == request.auth.uid || 
                    resource.data.mitraId == request.auth.uid || 
                    isOperasional() || isAdmin()
                  );
      allow list: if isSignedIn() && (
                    resource.data.jamaahId == request.auth.uid || 
                    resource.data.mitraId == request.auth.uid || 
                    isOperasional() || isAdmin()
                  );
      allow create: if isSignedIn() && 
                    (('jamaahId' in incoming() && incoming().jamaahId == request.auth.uid) || 
                     ('mitraId' in incoming() && incoming().mitraId == request.auth.uid) || 
                     isOperasional() || isAdmin()) &&
                    isValidBooking(incoming());
      allow update: if isOperasional() || isAdmin() || 
                    (isSignedIn() && (
                      ('jamaahId' in existing() && existing().jamaahId == request.auth.uid) || 
                      ('mitraId' in existing() && existing().mitraId == request.auth.uid)
                    ) && isValidBooking(incoming()));
      allow delete: if isOperasional() || isAdmin() || 
                    (isSignedIn() && (
                      ('jamaahId' in existing() && existing().jamaahId == request.auth.uid) || 
                      ('mitraId' in existing() && existing().mitraId == request.auth.uid)
                    ));
    }

    match /maskapai/{maskapaiId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(maskapaiId);
    }

    match /vendor_services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(serviceId);
    }

    match /master_hotels/{hotelId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(hotelId);
    }

    match /master_layanan/{layananId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(layananId);
    }

    match /master_merchandise/{merchId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(merchId);
    }

    match /master_bandara/{bandaraId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(bandaraId);
    }

    match /master_paket_wisata/{paketWisataId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(paketWisataId);
    }

    match /hotel_metadata/{mediaId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(mediaId);
    }

    match /paket_kemitraan/{paketId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(paketId);
    }

    match /pendaftaran_mitra/{pendaftaranId} {
      allow get: if isOperasional() || isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow list: if isOperasional() || isAdmin() || (isSignedIn() && resource.data.uplineId == request.auth.uid);
      allow create: if isValidPendaftaranMitra(incoming()); 
      allow update: if isOperasional() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    isValidPendaftaranMitra(incoming());
      allow delete: if isAdmin();
    }

    match /tracker_paket/{paketId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(paketId);
    }

    match /tracker_jamaah/{jamaahId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() || (isSignedIn() && (
                    incoming().get('mitraId', '') == request.auth.uid || 
                    incoming().get('bookingId', '') == request.auth.uid ||
                    existing().get('mitraId', '') == request.auth.uid ||
                    existing().get('bookingId', '') == request.auth.uid
                  ));
    }

    match /tracker_keberangkatan/{keberangkatanId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() && isValidId(keberangkatanId);
    }

    match /tracking_group/{groupId} {
      allow read: if isSignedIn();
      allow write: if isOperasional() || (isMitra() && incoming().leader_id == request.auth.uid);
    }

    match /mitra_tracker/{trackerId} {
      allow read: if isSignedIn();
      allow write: if (isFinance() || isOperasional()) && isValidId(trackerId);
    }

    match /mitra_followup/{followupId} {
      allow read: if isSignedIn();
      allow write: if (isFinance() || isOperasional()) && isValidId(followupId);
    }

    match /mitra_payment_history/{payId} {
      allow read: if isSignedIn();
      allow write: if (isFinance() || isOperasional()) && isValidId(payId);
    }

    match /perlengkapan_master/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /perlengkapan_packing/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /perlengkapan_pengiriman/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /perlengkapan_penerimaan/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /perlengkapan_komplain/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /package_cost_components/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /package_cost_audit_logs/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /ad_network_config/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /ad_campaigns/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /ad_performance_logs/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(id);
    }

    match /shop_orders/{orderId} {
      allow get, list: if isSignedIn() && (resource.data.jamaahId == request.auth.uid || resource.data.mitraId == request.auth.uid || isOperasional() || isAdmin());
      allow create: if isSignedIn() && (incoming().jamaahId == request.auth.uid || incoming().mitraId == request.auth.uid) && isValidShopOrder(incoming());
      allow update: if isOperasional() || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
